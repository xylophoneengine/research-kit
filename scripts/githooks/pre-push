#!/usr/bin/env bash
# Runs scripts/release_check.sh over exactly the commits being pushed and
# refuses the push on failure. Enable once per clone:
#   git config core.hooksPath scripts/githooks
# git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail
# git hands hooks of a linked worktree GIT_DIR (and may set more); drop them,
# so nothing the gate starts can act on this repo by accident. git runs hooks
# from the worktree root, so the repo is found again from there.
cd "$(git rev-parse --show-toplevel)"
unset $(git rev-parse --local-env-vars)
gate="$PWD/scripts/release_check.sh"
while read -r lref lsha rref rsha; do
  case "$lsha" in *[!0]*) ;; *) continue ;; esac # branch deletion
  case "$rsha" in
    *[!0]*) range="$rsha..$lsha" ;;
    *) range="origin/main..$lsha" ;; # new branch
  esac
  echo "pre-push: $lref -> $rref: release_check $range"
  # Ref names are published too; a tag may point at an already public commit.
  # Ref names hold no spaces, so $tag splits safely.
  tag=""
  case "$lref" in refs/tags/*) tag="--tag $lref" ;; esac
  bash "$PWD/scripts/anon_check.sh" --allow-from "$lsha" --name "$lref" \
    --name "$rref" $tag "$range" </dev/null || {
    echo "pre-push: push refused ($lref): ref name or tag text" >&2
    exit 1
  }
  bash "$gate" "$range" </dev/null || {
    echo "pre-push: push refused ($lref); rerun: scripts/release_check.sh $range" >&2
    exit 1
  }
done
